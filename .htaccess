RewriteEngine On

RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# PWA publicas: URL oficial /apps/{nombre-app}/
# Ruta fisica interna: /public/apps/{nombre-app}/
RewriteCond %{DOCUMENT_ROOT}/apps/$1 -d
RewriteRule ^apps/([^/]+)(/.*)?$ - [L]
RewriteRule ^apps/([^/]+)/(.*\.(?:png|ico|json|js|css))$ public/apps/$1/$2 [L,QSA,NC]
RewriteRule ^apps/(.*)$ public/apps/$1 [L,QSA]

# API v1 corporativa
RewriteRule ^api/v1/health/?$ api/v1/health/index.php [L,QSA,NC]
RewriteRule ^api/v1/auth/login/?$ api/v1/auth/login.php [L,QSA,NC]
RewriteRule ^api/v1/auth/logout/?$ api/v1/auth/logout.php [L,QSA,NC]
RewriteRule ^api/v1/auth/me/?$ api/v1/auth/me.php [L,QSA,NC]
RewriteRule ^api/v1/auth/session/?$ api/v1/auth/session.php [L,QSA,NC]
RewriteRule ^api/v1/apps/visor_sigest/?$ api/v1/apps/visor_sigest/index.php [L,QSA,NC]
RewriteRule ^api/v1/admin/config/?$ api/v1/admin/config.php [L,QSA,NC]
RewriteRule ^api/v1/admin/dashboard/?$ api/v1/admin/identity.php?resource=dashboard [L,QSA,NC]
RewriteRule ^api/v1/admin/catalogs/?$ api/v1/admin/identity.php?resource=catalogs [L,QSA,NC]
RewriteRule ^api/v1/admin/audit/?$ api/v1/admin/identity.php?resource=audit [L,QSA,NC]
RewriteRule ^api/v1/admin/users/?$ api/v1/admin/identity.php?resource=users [L,QSA,NC]
RewriteRule ^api/v1/admin/users/([0-9]+)/?$ api/v1/admin/identity.php?resource=users&id=$1 [L,QSA,NC]
RewriteRule ^api/v1/admin/users/([0-9]+)/(applications|roles|modules)/?$ api/v1/admin/identity.php?resource=users&id=$1&action=$2 [L,QSA,NC]
RewriteRule ^api/v1/admin/applications/?$ api/v1/admin/identity.php?resource=applications [L,QSA,NC]
RewriteRule ^api/v1/admin/applications/([0-9]+)/?$ api/v1/admin/identity.php?resource=applications&id=$1 [L,QSA,NC]
RewriteRule ^api/v1/admin/modules/?$ api/v1/admin/identity.php?resource=modules [L,QSA,NC]
RewriteRule ^api/v1/admin/modules/([0-9]+)/?$ api/v1/admin/identity.php?resource=modules&id=$1 [L,QSA,NC]
RewriteRule ^api/v1/admin/roles/?$ api/v1/admin/identity.php?resource=roles [L,QSA,NC]
RewriteRule ^api/v1/admin/roles/([0-9]+)/?$ api/v1/admin/identity.php?resource=roles&id=$1 [L,QSA,NC]
RewriteRule ^api/v1/admin/roles/([0-9]+)/modules/?$ api/v1/admin/identity.php?resource=roles&id=$1&action=modules [L,QSA,NC]
RewriteRule ^api/v1/admin/invitations/?$ api/v1/admin/invitations/index.php [L,QSA,NC]
RewriteRule ^api/v1/admin/invitations/([0-9]+)/?$ api/v1/admin/invitations/detail.php?id=$1 [L,QSA,NC]
RewriteRule ^api/v1/admin/invitations/([0-9]+)/revoke/?$ api/v1/admin/invitations/revoke.php?id=$1 [L,QSA,NC]
